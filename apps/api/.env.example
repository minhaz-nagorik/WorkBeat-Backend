# API login role: a member of workbeat_api, NOT a superuser (superusers bypass row-level security).
#   CREATE ROLE wb_api LOGIN PASSWORD '...' IN ROLE workbeat_api;   (after migration 0001, or create workbeat_api first)
DATABASE_URL=postgres://wb_api:CHANGE_ME@localhost:5432/workbeat_dev
# Database owner, used only by `pnpm db:migrate` and `pnpm seed`.
ADMIN_DATABASE_URL=postgres://postgres@localhost:5432/workbeat_dev
# 32 bytes, base64: openssl rand -base64 32. Encrypts licence keys / uninstall tokens, signs storage URLs.
SECRETS_ENCRYPTION_KEY=
# Screenshots and agent packages (local disk until a bucket provider is chosen).
STORAGE_DIR=./storage
# Optional: base for signed URLs (e.g. the cloudflared hostname). Default: the request's host.
# PUBLIC_BASE_URL=https://api.example.com
PORT=3000
# Email (invitations). Unset RESEND_API_KEY: messages are written to STORAGE_DIR/outbox instead (local only).
# RESEND_API_KEY=re_...
EMAIL_FROM=WorkBeat <no-reply@workbeat.io>
# Temporary until Resend: SMTP, used only when RESEND_API_KEY is unset. Gmail: an app password, and
# EMAIL_FROM must be the same Gmail address (Gmail rewrites any other sender).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# Web portal base URL, used in invitation links (<PORTAL_URL>/invite?token=...).
PORTAL_URL=http://localhost:3001
