{
  "name": "@workbeat/api",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p . && node --env-file-if-exists=.env dist/main.js",
    "db:migrate": "tsc -p . && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "seed": "tsc -p . && node --env-file-if-exists=.env dist/scripts/seed.js",
    "smoke": "tsc -p . && node --env-file-if-exists=.env dist/scripts/smoke.js",
    "smoke:portal": "tsc -p . && node --env-file-if-exists=.env dist/scripts/smoke-portal.js",
    "smoke:cleanup": "tsc -p . && node --env-file-if-exists=.env dist/scripts/smoke-cleanup.js",
    "smoke:token-expiry": "tsc -p . && node --env-file-if-exists=.env dist/scripts/smoke-token-expiry.js",
    "test": "tsc -p . && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-fastify": "11.2.10",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "8.15.4",
    "typescript": "5.9.3"
  }
}
