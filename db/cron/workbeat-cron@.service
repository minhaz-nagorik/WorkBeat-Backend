# Calls one /cron/<job> route of the WorkBeat API (run-scheduled-jobs `cron-routes`, task 2.4).
# %i is the job name, e.g. workbeat-cron@cleanup.service. Started only by its timer.
# /etc/workbeat/cron.env holds API_URL=https://<api host> and CRON_SECRET=<same value as the API's>;
# it is root-only (chmod 600), so the secret never appears in a unit file or a process listing's unit text.
[Unit]
Description=WorkBeat cron job %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/workbeat/cron.env
# --max-time above the job's budget (cleanup: 5 min); -f makes a 401/500 fail the unit.
# cleanup calls again while the API answers "more":true (budget spent), at most 12 calls (about an hour);
# other jobs are called once. $$ is a literal $ for the shell (systemd expands a single $).
ExecStart=/bin/sh -c 'n=0; while :; do out=$$(curl -fsS --max-time 900 -X POST "$API_URL/cron/%i" -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d "{}") || exit 1; echo "$$out"; n=$$((n + 1)); [ "%i" = cleanup ] && [ $$n -lt 12 ] || exit 0; case "$$out" in *\"more\":true*) ;; *) exit 0 ;; esac; done'
DynamicUser=yes
NoNewPrivileges=yes
